# Les descriptions sont lues par le plugin OnlyOffice (introspection)
# et affichées comme libellés dans l'onglet de sélection des données.

type Query {
    "Recherche par IPP exact ou début de nom / prénom (2 caractères minimum)"
    rechercherPatients(texte: String!): [Patient!]!
    patient(id: ID!): Patient
}

type Patient {
    id: ID!
    "IPP"
    ipp: String!
    "Nom d'usage"
    nom: String!
    "Nom de naissance"
    nomNaissance: String!
    "Prénom"
    prenom: String
    "Titre (Madame, Monsieur)"
    titre: String!
    "Date de naissance"
    dateNaissance: String!
    "Date de naissance AMO"
    dateNaissanceAmo: String
    "Âge (années révolues)"
    age: Int!
    "Âge (jours, mois ou années)"
    ageTexte: String!
    "Sexe"
    sexe: Sexe!
    "Courriel"
    email: String
    "Nationalité"
    nationalite: String
    "NIR"
    nir: String
    "Identité nationale de santé (INS)"
    insi: IdentiteNationaleSante
    "Adresse"
    adresse("Type d'adresse" type: TypeAdresse = PERSONNELLE): Adresse
    "Médecin traitant"
    medecinTraitant: Medecin
    "Personne à prévenir"
    personneAPrevenir: PersonneEntourage
    "Personne de confiance"
    personneDeConfiance: PersonneEntourage
    "Allergies"
    allergies(
        "Non levées uniquement"
        activesSeulement: Boolean = true
    ): [Allergie!]!
    "Antécédents"
    antecedents: [Antecedent!]!
    "Prescriptions (lignes)"
    prescriptions(
        "Nature de la prescription"
        nature: NaturePrescription,
        "Statut de la prescription"
        statut: StatutPrescription
    ): [LignePrescription!]!
    "Observations du dossier (fiches d'observation)"
    observationsMedicales(
        "Chapitre (MEDECINS, IDE, KINESITHERAPEUTE…)"
        chapitre: String,
        "Les N plus récentes"
        derniers: Int
    ): [ObservationMedicale!]!
    "Transmissions ciblées"
    transmissionsCiblees(
        "Les N plus récentes"
        derniers: Int
    ): [TransmissionCiblee!]!
    "Formulaires"
    formulaires(
        "Modèle de formulaire (identifiant)"
        modele: String,
        "Modèle contenant la rubrique (code)"
        contenant: String,
        "Les N plus récents"
        derniers: Int
    ): [Formulaire!]!
    "Observations (biologie, constantes)"
    observations(
        "Catégorie d'observation"
        categorie: CategorieObservation,
        "Code (ex. HBA1C)"
        code: String,
        "Depuis : durée ISO (P3M, P1Y) ou date (2026-01-31)"
        depuis: String
    ): [Observation!]!
    "Traitements"
    traitements(
        "En cours uniquement"
        actifsSeulement: Boolean = false
    ): [Traitement!]!
    "Séjour de référence (en cours, sinon le dernier terminé)"
    sejourCourant: Sejour
    "Séjours"
    sejours(
        "En cours uniquement"
        enCoursSeulement: Boolean = false
    ): [Sejour!]!
}

# Les descriptions des valeurs d'enum servent de libellés dans le document.
enum Sexe {
    "Féminin" FEMININ
    "Masculin" MASCULIN
    "Indéterminé" INDETERMINE
    "Inconnu" INCONNU
}

enum CategorieObservation {
    "Biologie" BIOLOGIE
    "Constante" CONSTANTE
}

enum TypeSejour {
    "Hospitalisation complète" HOSPITALISATION_COMPLETE
    "Hospitalisation de jour" HOSPITALISATION_JOUR
    "Consultation externe" CONSULTATION
    "Urgences" URGENCES
}

# Vocabulaire fermé repris du corpus PARHAF (projet PARTAGES, Health Data Hub).
enum TypeDocument {
    "Compte rendu d'hospitalisation" CRH
    "Compte rendu de consultation" CRC
    "Compte rendu opératoire" CRO
    "Compte rendu d'anatomopathologie" ANAPATH
    "Compte rendu des urgences" URGENCES
    "Compte rendu d'accouchement" ACCOUCHEMENT
    "Compte rendu de maternité" MATERNITE
}

type Sejour {
    "N° de séjour"
    numero: String!
    "Type de séjour"
    type: TypeSejour!
    "Date d'entrée"
    dateEntree: String!
    "Date de sortie"
    dateSortie: String
    "Durée (jours)"
    dureeJours: Int!
    "Service"
    service: String!
    "Motif"
    motif: String
    "Médecin responsable"
    medecinResponsable: String
    "Type du compte rendu rédigé pour ce séjour"
    typeDocument: TypeDocument
    "Diagnostic principal (code CIM-10)"
    diagnosticCim10Code: String
    "Diagnostic principal (libellé)"
    diagnosticCim10Libelle: String
    "Acte principal (code CCAM)"
    acteCcamCode: String
    "Acte principal (libellé)"
    acteCcamLibelle: String
    "UF médicale courante"
    ufMedicaleCourante: UniteFonctionnelle
    "UF d'hébergement courante"
    ufHebergementCourante: UniteFonctionnelle
    "Médecin adresseur"
    medecinAdresseur: Medecin
}

type UniteFonctionnelle {
    "Code UF"
    code: String!
    "Libellé UF"
    libelle: String!
    "Téléphone UF"
    telephone: String
    "Télécopie UF"
    fax: String
}

type Observation {
    "Catégorie"
    categorie: CategorieObservation!
    "Code"
    code: String!
    "Examen"
    libelle: String
    "Valeur"
    valeur: String
    "Unité"
    unite: String
    "Date"
    dateObservation: String!
    "Commentaire"
    commentaire: String
    "Auteur"
    auteur: String
    "Normalité (HPRIM)"
    normalite: String
}

type Traitement {
    "Molécule"
    molecule: String!
    "Posologie"
    posologie: String
    "Début"
    dateDebut: String!
    "Fin"
    dateFin: String
}

# ---------------------------------------------------------------------------------------------
# Document courant : signataires, destinataires, établissement émetteur, validation.
# Noms repris du contrat CDF (docs/hm/CDF.xlsx, feuille Types). Les liaisons de cette racine ne
# portent pas l'identifiant du document : c'est toujours le document en cours d'édition.
# ---------------------------------------------------------------------------------------------

extend type Query {
    "Document : signataires, destinataires, établissement émetteur, validation"
    document(id: ID!): Document
}

type Document {
    id: ID!
    "Titre du document"
    titre: String
    "Date de création"
    dateCreation: String!
    "Heure de création"
    heureCreation: String!
    "Date du document (à défaut, de création)"
    dateValeur: String
    "Heure du document (à défaut, de création)"
    heureValeur: String
    "Auteur du document"
    psCreateur: Medecin
    "Civilité de l'auteur"
    civilitePs: String
    "Nom prénom de l'auteur"
    nomPrenomPs: String
    "Catégorie de l'auteur"
    categoriePs: String
    "Établissement émetteur"
    etablissement: Etablissement
    "Signataire principal"
    signatairePrincipal: Signataire
    "Signataires secondaires"
    signatairesSecondaires: [Signataire!]!
    "Signataires (principal en premier)"
    signataires: [Signataire!]!
    "Destinataire principal"
    destinataire: Destinataire
    "Destinataires en copie"
    destinatairesEnCopie: [Destinataire!]!
    "Destinataires extérieurs"
    destinatairesExterieurs: [DestinataireExterieur!]!
    "Copie adressée au patient"
    destinatairePatient: Boolean!
    "Validation du document"
    validation: ValidationDocument
}

type Signataire {
    "Professionnel signataire"
    medecin: Medecin!
    "Identifiant national transcodé"
    rppsTranscode: String
}

type Destinataire {
    "Professionnel destinataire"
    medecin: Medecin!
    "Civilité"
    civilite: String
    "Nom"
    nom: String!
    "Prénom"
    prenom: String
    "Libellé (titre, prénom, nom)"
    libelle: String!
    "Code"
    code: String!
    "Identifiant national"
    identifiantNational: String
    "Spécialités"
    specialites: String
    "Courriel"
    email: String
    "Téléphone"
    telephone: String
    "Autre téléphone"
    telephoneAutre: String
    "Télécopie"
    fax: String
    "Adresse"
    adresse: Adresse
    "N° ID exemplaire"
    idExemplaire: String
}

type DestinataireExterieur {
    "Nom"
    nom: String!
    "Prénom"
    prenom: String
    "Courriel"
    email: String
}

type Medecin {
    "Code"
    code: String!
    "Titre médecin"
    titre: String
    "Nom"
    nom: String!
    "Prénom"
    prenom: String
    "Courriel"
    email: String
    "Qualité du P.S."
    qualite: String
    "Sexe (accords des courriers)"
    sexe: Sexe!
    "Type de médecin"
    typeMedecin: String!
    "Spécialités"
    specialitesConcatenees: String
    "Identifiant national transcodé"
    rppsTranscode: String
    "Identifiant national"
    identifiantNationalActif: IdentifiantNational
    "Immatriculations"
    immatriculations: [Immatriculation!]!
    "Adresse"
    adresse("Type d'adresse" type: TypeAdresse = PROFESSIONNELLE): Adresse
}

type IdentifiantNational {
    "Identifiant national"
    identifiantNational: String!
    "Identifiant national transcodé"
    rppsTranscode: String
}

type Immatriculation {
    "N° ADELI"
    adeli: String!
}

type Etablissement {
    "Libellé"
    libelle: String!
    "FINESS"
    finess: String!
    "FINESS transcodé"
    finessTranscode: String
    "SIRET"
    siret: String
    "Courriel"
    email: String
    "Adresse"
    adresse: Adresse
    "Téléphone principal"
    telephonePrincipal: Telephone
    "Téléphone secondaire"
    telephoneSecondaire: Telephone
}

type Adresse {
    "Adresse ligne 1"
    ligne1: String
    "Adresse ligne 2"
    ligne2: String
    "Adresse ligne 3"
    ligne3: String
    "Code postal"
    codePostal: String
    "Ville"
    ville: String
    "Pays"
    pays: String
    "Téléphone"
    telephone("Type de téléphone" type: TypeTelephone = FIXE): Telephone
}

type Telephone {
    "Numéro"
    numero: String!
}

type ValidationDocument {
    "Date de validation"
    dateValidation: String!
    "Heure de validation"
    heureValidation: String!
    "Professionnel validant"
    psValidant: Medecin
}

enum TypeAdresse {
    "Professionnelle" PROFESSIONNELLE
    "Personnelle" PERSONNELLE
    "Principale" PRINCIPALE
    "Naissance" NAISSANCE
}

enum TypeTelephone {
    "Fixe" FIXE
    "Portable" PORTABLE
    "Personnel" PERSONNEL
    "Principal" PRINCIPAL
    "Télécopie" FAX
    "Autre" AUTRE
}

# ---------------------------------------------------------------------------------------------
# Dossier clinique et formulaires : champs repris des gabarits legacy (Velocity) convertis en
# content controls. Correspondance : docs/conception/2026-11-21-conversion-gabarits-velocity.md
# ---------------------------------------------------------------------------------------------

type IdentiteNationaleSante {
    "Matricule INS"
    matricule: String!
    "Nature du matricule (NIR, NIA)"
    natureMatricule: String!
    "OID"
    oid: String!
    "Nom de naissance"
    nom: String!
    "Premier prénom de naissance"
    prenom: String
    "Prénoms de naissance"
    autresPrenoms: String
    "Prénom usuel"
    prenomUsuel: String
    "Date de naissance"
    dateNaissance: String!
    "Lieu de naissance (code INSEE)"
    lieuNaissance: String
    "Sexe"
    sexe: Sexe!
}

type PersonneEntourage {
    "Titre"
    titre: String
    "Nom"
    nom: String!
    "Prénom"
    prenom: String
    "Lien avec le patient"
    lienParente: String
    "Adresse"
    adresse("Type d'adresse" type: TypeAdresse = PERSONNELLE): Adresse
}

type Allergie {
    "Catégorie"
    categorie: String
    "Produit / molécule"
    libelle: String!
    "Texte libre"
    texte: String
    "Commentaire"
    commentaire: String
    "Début"
    dateDebut: String
    "Fin (allergie levée)"
    dateFin: String
}

type Antecedent {
    "Catégorie d'antécédent"
    libelleCategorie: String!
    "Libellé du diagnostic"
    libelle: String!
    "Statut de l'antécédent"
    statut: String
    "Date"
    dateDebut: String
}

enum NaturePrescription {
    "Médicaments" MEDICAMENTS
    "Biologie" BIOLOGIE
    "Actes" ACTES
    "Soins infirmiers" SOINS_INFIRMIERS
    "Plan de soins" PLAN_SOINS
    "Traitement habituel" TRAITEMENT_HABITUEL
}

enum StatutPrescription {
    "Validée" VALIDEE
    "En cours" EN_COURS
}

type LignePrescription {
    "Nature"
    nature: NaturePrescription!
    "Statut"
    statut: StatutPrescription!
    "Libellé de la ligne de prescription"
    libelle: String!
    "Posologie"
    posologie: String
    "Commentaire"
    commentaire: String
    "Début"
    dateDebut: String!
    "Fin"
    dateFin: String
}

type ObservationMedicale {
    "Chapitre"
    chapitre: String!
    "Date"
    date: String!
    "Heure"
    heure: String!
    "Observation"
    texte: String!
    "Auteur"
    auteur: Medecin
}

type TransmissionCiblee {
    "Cible"
    cible: String!
    "Date et heure"
    dateHeure: String!
    "Auteur"
    auteur: String
    "Données"
    donnees: String
    "Actions"
    actions: String
    "Résultats"
    resultats: String
    "État"
    etat: String
}

type Formulaire {
    "Modèle (identifiant)"
    modele: String!
    "Titre du formulaire"
    libelle: String
    "Date de création"
    dateCreation: String!
    "Date de modification"
    dateModification: String
    "Créé par"
    auteur: String
    "Valeur d'une rubrique"
    rubrique("Code de la rubrique" code: String!): String
}
